# ─────────────────────────────────────────────────────────────
# konnect FRONTEND 환경변수 예시 (committed template)
# 로컬은 이 파일을 .env.local 로 복사해 쓴다(.env* 는 gitignore 대상).
# ─────────────────────────────────────────────────────────────

# BE 주소. 미설정이면 '/api' 로 떨어지고 next.config 의 rewrites 가 프록시한다.
# 같은 오리진으로 서빙하려면 비워 두는 편이 낫다(CORS 불필요).
NEXT_PUBLIC_API_BASE_URL=

# next.config rewrites 의 프록시 대상 — **빌드 시점** 환경변수다.
API_PROXY_TARGET=http://localhost:4000
