      "expected": "한국어-제목"
    },
    {
      "input": "Tiếng Việt",
      "expected": "tiếng-việt"
    },
    {
      "input": "ĐÀ NẴNG",
      "expected": "đà-nẵng"
    },
    {
      "input": "F-2-7 점수제",
      "expected": "f-2-7-점수제"
    },
    {
      "input": "日本語のタイトル",
      "expected": "日本語のタイトル"
    },
    {
      "input": "Multiple   Spaces",
      "expected": "multiple-spaces"
    },
    {
      "input": "UPPER lower",
      "expected": "upper-lower"
    },
    {
      "input": "",
      "expected": ""
    },
    {
      "input": " ",
      "expected": ""
    },
    {
      "input": "---",
      "expected": ""
