    {
      "input": "nationality:VN",
      "expected": "nationality:vn"
    },
    {
      "input": "a:b:c",
      "expected": "a:b:c"
    },
    {
      "input": ":::",
      "expected": ":::"
    },
    {
      "input": "lang:KO",
      "expected": "lang:ko"
