// konnect 데이터 스키마.
//
// 변경 후: `npm run db:migrate` (로컬) / `npm run db:deploy` (운영)
//
// ── 이 스키마의 결정들 ──────────────────────────────────────────────
//
// 1. **비밀번호 컬럼이 없다.** 로그인은 OAuth 전용이다.
//    비밀번호를 보관하지 않으면 유출·재사용·재설정 흐름이 통째로 사라진다.
//    타깃 사용자가 여러 나라에 흩어져 있어 계정 복구 지원이 특히 어렵다는 점도 있다.
//    → docs/30-architecture/05-authentication.md
//
// 2. **id 는 UUIDv7 문자열**이다(DB 기본값이 아니라 애플리케이션이 만든다).
//    상위 비트가 타임스탬프라 사전식 = 시간순이고, 그래서 **커서 = id 하나**로
//    키셋 페이지네이션이 성립한다. B-tree 삽입도 append-only 에 가깝다.
//    → docs/30-architecture/03-api-conventions.md
//
// 3. **시각은 timestamptz.** 사용자가 여러 시간대에 흩어져 있다 —
//    이 서비스에서는 실질적 요구사항이지 취향이 아니다.
//
// 4. **물리 삭제가 없다.** status 로 숨긴다. 답변이 달린 질문을 지우면 링크가
//    죽고 그 답변들이 무엇에 대한 답인지 알 수 없게 된다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────
//  사용자 · 인증
// ─────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

/// 사용자.
///
/// **민감정보를 담지 않는다** — 체류자격·학교·직장·실명·국적이 여기 없는 것은
/// 누락이 아니라 결정이다. 저장하는 순간 보관 책임이 생기고, 우리 타깃은
/// 그 정보가 노출됐을 때 피해가 큰 위치에 있다.
///
/// 이메일도 없다. OAuth 제공자가 주지만 쓸 데가 없고, 갖고 있으면 유출 대상만 늘어난다.
model User {
  id        String   @id @db.VarChar(36)
  nickname  String   @db.VarChar(24)
  avatarUrl String?  @db.VarChar(500)
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  identities AuthIdentity[]
  questions  Question[]
  answers    Answer[]

  /// 닉네임은 표시용이라 유일할 필요는 없지만, 중복 확인 쿼리가 잦아 인덱스를 둔다
  @@index([nickname])
  @@map("users")
}

enum AuthProvider {
  GOOGLE
  APPLE
  LINKEDIN
  KAKAO
  NAVER
}

/// 소셜 계정 연결.
///
/// 한 사용자에 여러 개를 붙일 수 있다 — 같은 사람이 구글/애플로 각각 가입해
/// 계정이 갈라지는 것을 나중에 병합할 수 있게 하기 위해서다.
///
/// **(provider, providerId) 가 유일하다.** 이게 로그인의 유일한 식별 경로다 —
/// 이메일로 찾지 않는다. 제공자가 준 이메일이 검증됐다는 보장이 없고,
/// 검증되지 않은 이메일로 기존 계정에 붙이면 계정 탈취 경로가 된다.
model AuthIdentity {
  id         String       @id @db.VarChar(36)
  userId     String       @db.VarChar(36)
  provider   AuthProvider
  /// 제공자가 준 고유 id(`sub`). 제공자 안에서만 고유하다.
  providerId String       @db.VarChar(255)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_identities")
}

// ─────────────────────────────────────────────────────────────────────
//  Q&A
// ─────────────────────────────────────────────────────────────────────

/// 글쓴이가 무엇을 하려는가. `Topic`(무엇에 대한 글인가)과 **다른 축**이고,
/// 게시판은 둘의 곱이다 — /ko/visa?type=review.
///
/// 형식(Guide·Checklist)이 아니라 의도로 자른 이유는 이 제품에 전문가가 없기
/// 때문이다 — 권위 있는 안내 형식을 열면 틀린 해석이 '가이드'라는 이름을 달고 쌓인다.
///
/// 지금 작성 폼이 있는 것은 QUESTION 뿐이다. 나머지 셋을 미리 둔 이유는
/// enum 값을 나중에 더하면 마이그레이션이 한 번 더 필요하기 때문이다 —
/// 값이 있어도 만들 경로가 없으면 아무 일도 일어나지 않는다.
enum PostType {
  QUESTION
  REVIEW
  SHARE
  RECRUIT
}

/// 주제 — docs/10-domain 의 6영역과 대응한다.
/// 태그와 달리 하나만 고르고 필수다. 목록의 1차 분류다.
enum Topic {
  VISA
  LANGUAGE
  EDUCATION
  HOUSING
  WORK
  SOCIAL
}

/// 공개 상태. HIDDEN 은 작성자에게만 보인다 — 아니면 되살릴 방법이 없다.
enum ContentStatus {
  OPEN
  HIDDEN
}

model Question {
  id       String        @id @db.VarChar(36)
  authorId String        @db.VarChar(36)
  title    String        @db.VarChar(200)
  body     String        @db.Text
  topic    Topic
  /// 기본값이 QUESTION 인 이유: 이 필드가 생기기 전의 글은 전부 질문이었다.
  /// 기본값이 없으면 기존 행에 채울 값이 없어 마이그레이션이 막힌다.
  type     PostType      @default(QUESTION)
  status   ContentStatus @default(OPEN)

  /// 채택된 답변. 질문 작성자만 고르고 하나뿐이다.
  ///
  /// FK 를 걸지 않는 이유: Answer.questionId 와 **순환 참조**가 되어 삽입 순서가
  /// 꼬인다. 답변이 그 질문의 것인지는 서비스가 검증하고 e2e 가 지킨다.
  acceptedAnswerId String? @db.VarChar(36)

  /// 비정규화 카운터. 목록에서 매번 COUNT(*) 를 하면 느리다.
  /// 답변 생성·숨김 시 서비스가 함께 갱신한다.
  answerCount Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  author  User          @relation(fields: [authorId], references: [id])
  answers Answer[]
  tags    QuestionTag[]

  /// 목록의 기본 정렬은 id 역순(= 최신순)이고, 그 앞에 status 필터가 붙는다.
  /// 복합 인덱스 순서는 **필터 먼저, 정렬 나중**이어야 인덱스를 탄다.
  @@index([status, id(sort: Desc)])
  @@index([topic, status, id(sort: Desc)])
  /// 게시판 = topic × type. 필터가 앞, 정렬이 뒤여야 인덱스를 탄다.
  /// 지금은 전부 QUESTION 이라 선택도가 낮지만, 값이 섞이기 시작하면 이 순서가 듣는다.
  @@index([topic, type, status, id(sort: Desc)])
  @@index([authorId, id(sort: Desc)])
  /// "아직 답 없는 질문" 필터 — 답변자가 가장 자주 쓰는 목록이다
  @@index([status, answerCount, id(sort: Desc)])
  @@map("questions")
}

model Answer {
  id         String        @id @db.VarChar(36)
  questionId String        @db.VarChar(36)
  authorId   String        @db.VarChar(36)
  body       String        @db.Text
  status     ContentStatus @default(OPEN)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  /// 한 질문의 답변을 오래된 순으로 읽는다(답변은 대화가 아니라 후보다)
  @@index([questionId, id])
  @@index([authorId, id(sort: Desc)])
  @@map("answers")
}

// ─────────────────────────────────────────────────────────────────────
//  태그
// ─────────────────────────────────────────────────────────────────────

/// 태그.
///
/// `namespace` 가 있으면 **고정 어휘**(관리자만 추가), 없으면 자유 태그다.
/// 표기가 갈라지면(D-2 / d2 / D2) 필터가 무너지므로 저장 전에 정규화한다 —
/// 그 규칙은 BE `utils/string.slugify` 와 FE `lib/text/slug` 가 공유한다(계약).
///
/// 별도 테이블로 두는 이유: 문자열 배열로 두면 "이 태그를 쓴 질문 수"나
/// 태그 목록 자동완성을 매번 전체 스캔해야 한다.
model Tag {
  id        String   @id @db.VarChar(36)
  /// visa / region / school / topic / lang. 자유 태그는 null.
  namespace String?  @db.VarChar(24)
  /// 정규화된 값 (`d-2`, `seoul`)
  value     String   @db.VarChar(64)
  /// 저장 형태 전체 (`visa:d-2`) — 조회 편의를 위한 비정규화
  raw       String   @db.VarChar(96)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  questions QuestionTag[]

  @@unique([raw])
  @@index([namespace, value])
  @@map("tags")
}

/// 질문 ↔ 태그 (N:M).
///
/// 태그 필터는 **AND** 다 — 여러 태그를 모두 가진 질문을 찾으려면
/// 이 조인 테이블을 태그 수만큼 접거나 GROUP BY HAVING COUNT 로 센다.
model QuestionTag {
  questionId String @db.VarChar(36)
  tagId      String @db.VarChar(36)

  /// 입력 순서.
  ///
  /// 순서를 저장하는 이유: 사용자가 **먼저 적은 태그가 더 중요할 가능성이 높고**,
  /// 순서가 흔들리면 같은 질문의 태그 목록이 조회마다 달라 보인다.
  /// 조인 결과의 순서는 보장되지 않으므로 컬럼으로 못박는다.
  position Int @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  /// 태그로 질문을 찾는 방향 — 목록 필터가 이 인덱스를 탄다
  @@index([tagId, questionId])
  /// 한 질문의 태그를 입력 순서대로 읽는다
  @@index([questionId, position])
  @@map("question_tags")
}
