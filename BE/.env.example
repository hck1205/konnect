# ─────────────────────────────────────────────────────────────
# konnect BACKEND 환경변수 예시 (committed template)
#
# 실행 환경(NODE_ENV)에 따라 .env.${NODE_ENV} → .env 순서로 로드된다.
#   - 로컬:  .env.development  (이 예시를 복사해 만든다)
#   - 운영:  OS/배포 플랫폼 환경변수로 직접 주입 (.env.production 파일은 커밋하지 않는다)
# .env* 는 .gitignore 대상이며, 이 .env.example 만 커밋된다.
# ─────────────────────────────────────────────────────────────

# 실행 환경: development | production | test
NODE_ENV=development

# HTTP 서버 포트
PORT=4000

# CORS 허용 오리진 (FE 개발 서버 주소)
CORS_ORIGIN=http://localhost:3000

# JWT 서명 비밀키 — 운영에서는 **반드시** 강력한 임의 값으로 교체한다.
# 기본값이 그대로 쓰이면 누구나 토큰을 위조해 아무 계정으로 행세할 수 있다.
JWT_SECRET=change-me-in-production

# 액세스 토큰 만료 (예: 1d, 12h, 30m)
JWT_EXPIRES_IN=1d

# 저장소 드라이버: memory(인메모리) | prisma(Postgres)
#   - 미설정 시 기본값 memory (DB 없이 동작 — 테스트/데모)
#   - prisma 로 두면 DATABASE_URL 이 필요하다
DB_DRIVER=memory

# Postgres 연결 문자열 (DB_DRIVER=prisma 일 때 필수)
#   로컬:  postgresql://konnect:konnect@localhost:5432/konnect_dev?schema=public
#   운영:  postgresql://<user>:<password>@<host>:5432/<db>?schema=public
DATABASE_URL=postgresql://konnect:konnect@localhost:5432/konnect_dev?schema=public

# ─────────────────────────────────────────────────────────────
# 법제처 국가법령정보 OPEN API 인증키 (OC 값)
#
# 공식 출처 감시가 출입국관리법·시행령·국적법의 **개정 여부**를 확인하는 데 쓴다.
#   → docs/20-product/10-features/11-official-sources.md
#
# ⚠️ 키만으로는 안 된다. **호출하는 서버의 IP 가 사전 등록**되어 있어야 한다.
#    등록되지 않은 IP 에서 부르면 200 과 함께 이런 본문이 온다:
#      {"result":"사용자 정보 검증에 실패하였습니다.",
#       "msg":"... 정확한 서버장비의 IP주소 및 도메인주소를 등록해 주세요."}
#    그래서 GitHub Actions 에서는 돌릴 수 없다(러너 IP 가 매번 바뀐다).
#    A1 서버 cron 에서 돈다 → deploy/a1-watch-sources.sh
#    발급·IP 등록: https://open.law.go.kr → OPEN API 신청 → API인증키관리
#
# 값은 가입 이메일의 아이디 부분이 관례다(직접 지정 가능).
#
# 이름에 KONNECT_ prefix 를 붙인다 — 운영 서버 .env 는 한 박스의 여러 앱이
# 공유하므로 앱별로 이름을 구분한다. prefix 없는 LAW_API_KEY 도 받지만
# (로컬 편의) 운영은 prefix 쪽을 쓴다.
#
# 비워 두어도 된다 — 법령 3건만 건너뛰고 페이지 감시는 그대로 돈다.
# 부분 동작이 의도된 설계다: 키 없이도 나머지를 확인할 수 있어야 한다.
# ─────────────────────────────────────────────────────────────
KONNECT_LAW_API_KEY=
